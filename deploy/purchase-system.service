# 本番環境用 systemd サービスファイル
# podman-compose を systemd で自動起動する
#
# 配置先: /etc/systemd/system/purchase-system.service
# 有効化: sudo systemctl enable --now purchase-system

[Unit]
Description=Purchase System (podman-compose)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/purchase-system
ExecStart=/usr/bin/podman-compose up -d
ExecStop=/usr/bin/podman-compose down
Restart=on-failure

[Install]
WantedBy=multi-user.target
